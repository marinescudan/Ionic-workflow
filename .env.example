# ===========================================
# Ionic App Configuration
# ===========================================

# App Information
APP_NAME="Ionic Learning App"
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# API Endpoints
API_BASE_URL=http://localhost:4000
GRAPHQL_ENDPOINT=http://localhost:4000/graphql
GRAPHQL_WS_ENDPOINT=ws://localhost:4000/graphql

# WebRTC Signaling Server
SIGNALING_SERVER_URL=http://localhost:3001
SIGNALING_SERVER_PORT=3001

# Network Configuration
# Leave empty for localhost, or set to your local IP for network testing
# Example: 192.168.1.100
LOCAL_NETWORK_IP=

# App Server Configuration
APP_PORT=8100

# Feature Flags
FEATURE_VIDEO_CALLS=true
FEATURE_SCREEN_SHARE=false
FEATURE_CHAT=false
FEATURE_AUDIO_ONLY_CALLS=false
FEATURE_RECORDING=true

# WebRTC Configuration
WEBRTC_TEST_MODE=false
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302

# UI Configuration
UI_THEME=auto
UI_LANGUAGE=en
UI_SHOW_DEBUG_INFO=false

# Analytics (optional)
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=

# Error Reporting (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ===========================================
# Environment-specific configurations:
# 
# Development:
#   - Use localhost URLs
#   - Enable debug features
#   - Use local network IP for device testing
#
# Staging:
#   - Use staging server URLs
#   - Enable some debug features
#   - Disable analytics
#
# Production:
#   - Use production HTTPS URLs
#   - Disable all debug features
#   - Enable analytics and monitoring
# ===========================================

# ===========================================
# Instructions:
# 1. Copy this file to .env
# 2. Update values for your environment
# 3. Run: npm run setup:network (auto-detects IP)
#    Or: npm run setup:localhost (use localhost)
# 4. Never commit .env to git
# ===========================================
